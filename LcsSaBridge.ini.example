[LCS]
; 1 (default): user files beside gta_sa.exe; 0: the Windows Documents folder.
; Both modes use this exclusive folder; never GTA San Andreas User Files.
PortableUserFiles=1
UserFilesFolder=GTA Liberty City Stories User Files
; Campaign packages need no paths: every folder is a subfolder of the .asi,
; and the original PS2 AUDIO folder is copied next to it (docs/audio.md).
; 0 keeps SA's own radio stations instead of the original LCS radio.
LcsRadio=1
; 0 keeps SA's own gun fire/reload sounds instead of the LCS samples of each converted weapon (docs/audio.md).
LcsWeaponSounds=1
; LCS vehicle sounds (docs/audio.md), one switch each; 0 keeps the SA sound of that kind.
LcsVehicleHorns=1
LcsVehicleSirens=1
LcsVehicleDoors=1
LcsVehicleEngines=1
; LCS menu, pickup, HUD and jingle sounds instead of SA's frontend sounds (docs/audio.md).
LcsInterfaceSounds=1
; Audible range of gun shots and car doors as a percentage of the original LCS range (10..100). The original
; ranges (120 m / 50 m) are far larger than SA's, so distant gunfire and doors sound like stray noises.
LcsOneShotRangePercent=50
; Straight hand aim (docs/hand-aim.md): the aiming hand of one-handed guns is kept upright for CJ and NPCs.
; Every key below defaults to 1 (on) when absent; 0 turns that part off. HandAim=0 turns the whole feature off.
HandAim=1
HandAimCJ=1
HandAimNPCs=1
HandAimGrove=1
HandAimBallas=1
HandAimOtherGangs=1
HandAimCops=1
HandAimCivilians=1
HandAimOtherPeds=1
HandAimDualLeftHand=1
HandAimSameAnimationGroup=1
; Weapon types added by other mods that are not covered by their animation group, e.g. 40,41
HandAimExtraWeaponTypes=
; 0 forearm line (steadiest), 1 hand axis from the game's aim, 2 blend (HandAimBlendPercent)
HandAimAxis=0
HandAimBlendPercent=50
HandAimMaxDeviationDegrees=20
HandAimBlendInMs=150
HandAimBlendOutMs=350
; If weapons look turned in the hand while aiming: roll about the barrel (-180..180, try 180 for upside down, 90/-90 for sideways)
HandAimRollDegrees=0
; Hand axis kept vertical: 2 (default) or 1
HandAimUprightAxis=2
